{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/yomiyasu-gate.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\"",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/yomiyasu-gate.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
