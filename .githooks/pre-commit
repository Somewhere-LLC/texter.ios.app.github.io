#!/bin/bash
# Blocks commits whose Japanese pages break the yomiyasu rules. Enable with: git config core.hooksPath .githooks
if git diff --cached --name-only | grep -qE '\.html$|^scripts/(guides|seo)/|^scripts/check-yomiyasu|^scripts/yomiyasu-baseline'; then
  python3 "$(git rev-parse --show-toplevel)/scripts/check-yomiyasu.py" || exit 1
fi
exit 0
